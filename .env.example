# Copy to .env for local or VPS use. Keep real keys and production passwords private.
# Object storage key for photo uploads. Leave blank only if uploads are not needed.
EMERGENT_LLM_KEY=

# HTTPS deployments must use true; plain local HTTP uses false.
COOKIE_SECURE=false

# CORS origin(s), comma-separated. Set to https://relaylab.id for the VPS deployment.
CORS_ORIGINS=*

# Set both PUBLIC_URL and REACT_APP_BACKEND_URL to /production for a subpath deployment.
# Leave blank to serve from the domain root.
PUBLIC_URL=
REACT_APP_BACKEND_URL=

# Defaults preserve the Windows/LAN guide. On a VPS, set 127.0.0.1 and 8081.
FRONTEND_BIND=0.0.0.0
FRONTEND_PORT=80

# These are only used when MongoDB has no users yet. Replace all before the first
# production startup; existing users are not reset by changing these values.
SEED_ADMIN_PASSWORD=admin123
SEED_PRODUCTION_PASSWORD=prod123
SEED_QC_PASSWORD=qc123
